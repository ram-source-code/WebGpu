; OPTIONAL. The site runs without any .env: links use the host it is served from, secret keys are
; generated on first run (data/keys.php), and form messages are saved and emailed to CONTACT_EMAIL.
; To change something, copy this file to .env and fill only the keys you need. Always double quotes.

SITE_NAME      = "Ramyar Salah"
; your domain without https://, e.g. "ramyarsalah.com": turns on one 301 redirect to https://that-domain
CANONICAL_HOST = ""
; shown on the site and receives form messages (default: ramyar.techie@gmail.com)
CONTACT_EMAIL  = ""
; phone and WhatsApp, international form (default: +9647700835557)
CONTACT_PHONE  = ""
; Facebook page or profile link (default: the share link Ramyar gave)
FACEBOOK_URL   = ""
; optional SMTP for form emails; empty SMTP_HOST = the host's built-in mail() is used
SMTP_HOST      = ""
SMTP_PORT      = "587"
SMTP_USER      = ""
SMTP_PASS      = ""
MAIL_FROM      = ""
MAIL_TO        = ""

[production]
