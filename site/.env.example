; OPTIONAL. The site runs without any .env: links use the host it is served from, secret keys are
; generated on first run (data/keys.php), and the contact form only saves messages.
; To change something, copy this file to .env and fill only the keys you need. Always double quotes.

SITE_NAME      = "Ramyar Salah"
; your domain without https://, e.g. "ramyarsalah.com": turns on one 301 redirect to https://that-domain
CANONICAL_HOST = ""
; shown on the site and used for mailto links; empty = contact form only
CONTACT_EMAIL  = ""
; email a copy of every message (SMTP from your host's email account); empty SMTP_HOST = off
SMTP_HOST      = ""
SMTP_PORT      = "587"
SMTP_USER      = ""
SMTP_PASS      = ""
MAIL_FROM      = ""
MAIL_TO        = ""

[production]
