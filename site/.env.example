; .env.example: the keys of .env with no values. Copy to .env and fill each section.
SITE_NAME = ""

[local]                                 ; chosen when the site folder matches a `when` glob
when           = "*/htdocs/*, */webgpu/site/*"
CANONICAL_HOST = ""
CONTACT_EMAIL  = ""
FORM_KEY       = ""
MAINT_KEY      = ""
; empty SMTP_HOST = messages are only saved to data/site.sqlite, no email is sent
SMTP_HOST      = ""
SMTP_PORT      = ""
SMTP_USER      = ""
SMTP_PASS      = ""
MAIL_FROM      = ""
MAIL_TO        = ""

[production]                            ; no `when`: chosen everywhere else
CANONICAL_HOST = ""
CONTACT_EMAIL  = ""
FORM_KEY       = ""
MAINT_KEY      = ""
SMTP_HOST      = ""
SMTP_PORT      = ""
SMTP_USER      = ""
SMTP_PASS      = ""
MAIL_FROM      = ""
MAIL_TO        = ""
