# Ramyar Salah portfolio. Works at the web root or in any subfolder: no RewriteBase, no hard-coded paths.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# Let's Encrypt renewal and security.txt
RewriteRule ^\.well-known/ - [L]

# One 301 hop to the canonical host is done in PHP for pages (bootstrap.php, from CANONICAL_HOST in .env).
# To also redirect static files, uncomment and replace example.com with the real host (spec E.b):
# RewriteCond %{SERVER_ADDR} !^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|::1$)
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^example\.com$ [NC]
# RewriteRule ^ https://example.com%{REQUEST_URI} [L,R=301]

# dotfiles, state and code are never served
RewriteRule (^|/)\. - [F]
RewriteRule (^|/)(data|includes)(/|$) - [F]

# one entry point: no PHP file but index.php runs, not even with a trailing /path
RewriteCond %{REQUEST_URI} \.(php\d?|phtml|phar)(/|$) [NC]
RewriteRule !^index\.php$ - [F]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[/?\s] [NC]
RewriteRule ^ - [F]

# everything that isn't an existing file goes to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

<FilesMatch "\.(sqlite|sqlite3|db|log|json|md|env|example|bak|zip|flag|ini|sh)$">
  Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/avif .avif
AddType image/webp .webp
AddDefaultCharset UTF-8
AddCharset UTF-8 .css .js .svg .txt

<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=(), unload=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  <FilesMatch "^(favicon\.ico|icon\.svg|apple-touch-icon\.png|og-default\.jpg|robots\.txt|OFL\.txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(favicon\.ico|icon\.svg|apple-touch-icon\.png|og-default\.jpg)$">
    Header always set Cross-Origin-Resource-Policy "cross-origin"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript image/svg+xml application/xml application/manifest+json
</IfModule>
